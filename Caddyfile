# HTTPS 종단. Caddy가 Let's Encrypt 인증서를 알아서 발급하고 갱신한다
# (nginx + certbot을 직접 엮는 것보다 손이 훨씬 적게 간다).
#
# DOMAIN은 .env에서 온다. 예: voylog.duckdns.org
#
# 앱은 여기(443)로만 붙고 백엔드 4000번은 바깥에 열지 않는다 --
# docker-compose에서 backend는 expose만 하고 ports는 없다.
#
# X-Forwarded-For / -Proto / -Host는 Caddy가 자동으로 붙인다. 백엔드는
# TRUST_PROXY=1일 때만 그 헤더를 믿고 req.ip를 읽는다. 그 값을 안 주면
# 모든 사용자가 프록시 IP 하나로 묶여 레이트 리밋에 같이 걸린다.

{$DOMAIN} {
	# 백엔드가 통째로 받는다: /api/v1, /health, 그리고 프로필 사진인
	# /uploads까지. 경로별로 나눌 이유가 없다.
	reverse_proxy backend:4000

	encode gzip

	log {
		output stdout
		format console
	}
}
