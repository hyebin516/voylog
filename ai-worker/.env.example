OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KAKAO_REST_API_KEY=
YOUTUBE_API_KEY=
AI_WORKER_PORT=8000

# Shared secret this worker requires in the X-Worker-Token header. Must match
# AI_WORKER_TOKEN in backend/.env. Empty means the check is off -- fine
# locally, not fine for a worker with a public address.
AI_WORKER_TOKEN=
