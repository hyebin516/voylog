migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Environment variables (copy .env.example to .env and fill in real values)
.env
ios/Flutter/KakaoKeys.xcconfig

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase (FCM) config downloaded from the console
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# 벤더링한 플러그인을 빌드하면 생기는 것들. 7개 파일이 실제로 커밋돼 있었고,
# 빌드할 때마다 잠금 파일이 수정된 걸로 떠서 변경 목록을 더럽혔다.
third_party/*/android/.gradle/
third_party/*/android/build/
