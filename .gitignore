.DS_Store
Thumbs.db
.vscode/
.idea/

# Bulk public place datasets (SEMAS 상가정보 zip/CSV, TourAPI dumps) -- too large
# for git and subject to each dataset's license terms; kept locally only.
database/seed-data/

# Local dev-server logs (backend/ai-worker run output)
*_dev.log
backend/logs/

# Editor workspace file and the design-handoff archive (the unpacked
# "Voylog UI/" folder is what the repo actually uses)
travel_youtube_app.code-workspace
Voylog UI.zip

# Word/Excel lock files created while a document is open
~$*

# Redis 로컬 덤프 (개발 머신에서 생김, 저장소에 들어갈 이유 없음)
dump.rdb

# 폰트 원본 zip (필요한 weight만 뽑아 assets/fonts/에 둠)
travel_youtube_app/assets/fonts/*.zip

# 핸드오프 번들 원본 zip (압축 푼 폴더가 레포에 들어 있음)
Voylog UI/**/*.zip

# SSH/서버 인증키. 키는 프로젝트 밖(~/.ssh 등)에 두는 게 원칙이지만,
# 실수로 들어와도 커밋되지 않도록 막아둔다 — 한번 올라가면 서버 접근
# 권한이 그대로 공개된다.
*.pem
*.key
id_rsa*
