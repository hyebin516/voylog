PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/travel_youtube
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# 카카오 로그인은 앱이 카카오 SDK로 처리하고, 백엔드는 앱이 받아온
# 액세스 토큰으로 프로필만 조회한다(auth.service.js의 fetchKakaoProfile).
# 그래서 서버에는 카카오 키가 필요 없다 -- 지오코딩에 쓰는 REST API 키는
# ai-worker/.env 쪽에 있다.
AI_WORKER_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Voylog <no-reply@voylog.app>

# 한국관광공사 TourAPI (data.go.kr) -- only used by scripts/import-tour-api.js.
# Either the Encoding or Decoding key from data.go.kr works.
TOUR_API_KEY=

# Monthly refresh of the public-dataset places. Set to false to turn it off
# (e.g. on a second backend instance, so only one runs the refresh).
PUBLIC_DATA_REFRESH_ENABLED=true

# FR-12 push notifications (Firebase Cloud Messaging).
# Firebase console -> 프로젝트 설정 -> 서비스 계정 -> 새 비공개 키 생성.
# Never commit the key file itself.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# FR-13 고객센터: where app inquiries are forwarded (reply-to is the asker).
SUPPORT_EMAIL=support@voylog.app

# How many reverse proxies sit in front of this server, for Express' req.ip.
# Managed hosts (Render, Railway, Fly, a Nginx of your own) all put one in
# front: leave this at 0 there and every user shares one rate-limit bucket
# and gets blocked together. Set it to 1 behind a single proxy. Keep it 0
# locally -- trusting X-Forwarded-For with no proxy lets a caller forge any IP.
TRUST_PROXY=0

# Shared secret the AI worker requires in X-Worker-Token. The worker has no
# user accounts and spends money on every call, so if it is reachable from
# the internet this is the only thing between it and a stranger's script.
# Must match AI_WORKER_TOKEN in ai-worker/.env. Leave empty only when the
# worker is on a private network the internet cannot reach.
AI_WORKER_TOKEN=

# HTTPS를 담당하는 Caddy가 인증서를 발급받을 도메인.
# 예: voylog.duckdns.org (DuckDNS에서 무료로 받을 수 있다)
# 이 이름이 서버의 공인 IP를 가리키고 있어야 발급이 된다.
DOMAIN=
